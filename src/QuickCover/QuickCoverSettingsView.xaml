<UserControl x:Class="QuickCover.QuickCoverSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="560">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Image presets" FontWeight="SemiBold" />
            <Grid Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ImagePresetsComboBox" Margin="0,0,12,0"
                          IsEditable="True" IsReadOnly="True" IsTextSearchEnabled="False"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                          SelectionChanged="ImagePresetsComboBox_SelectionChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                        Content="×" ToolTip="Remove preset" Tag="{Binding}"
                                        Click="RemoveImagePresetButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" VerticalAlignment="Center" Padding="12,4"
                        Content="Save Current..." Click="SaveCurrentImagePresetButton_Click" />
            </Grid>
            <TextBlock Text="Default cover image" FontWeight="SemiBold" />
            <Grid Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Local file" Margin="0,0,0,4" Foreground="Gray" />
                <ComboBox x:Name="DefaultCoverImagePathHistoryComboBox"
                          Grid.Row="1"
                          Margin="0,0,12,8"
                          IsEditable="True"
                          IsReadOnly="True"
                          IsTextSearchEnabled="False"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Stretch"
                          DropDownClosed="DefaultCoverImagePathHistoryComboBox_DropDownClosed"
                          SelectionChanged="DefaultCoverImagePathHistoryComboBox_SelectionChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" ToolTip="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                        Content="×" ToolTip="Remove from history" Tag="{Binding}"
                                        Click="RemoveDefaultCoverImagePathHistoryButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Button Padding="12,4" Margin="0,0,8,0" Content="Browse..." Click="BrowseDefaultCoverImagePathButton_Click" />
                    <Button Padding="12,4" Content="Clear File" Click="ClearDefaultCoverImagePathButton_Click" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Image URL" Margin="0,0,0,4" Foreground="Gray" />
                <TextBox x:Name="DefaultCoverImageUrlTextBox" Grid.Row="3" Margin="0,0,12,8" VerticalContentAlignment="Center"
                         TextChanged="DefaultCoverImageUrlTextBox_TextChanged" LostFocus="DefaultCoverImageUrlTextBox_LostFocus" />
                <Button Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,8" Padding="12,4"
                        Content="Clear URL" Click="ClearDefaultCoverImageUrlButton_Click" />
                <StackPanel Grid.Row="4" Margin="0,0,12,0">
                    <TextBlock Text="Local preview" Margin="0,0,0,4" Foreground="Gray" />
                    <Border Width="220" Height="124" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4" Background="#11000000" Margin="0,0,0,8">
                        <Grid>
                            <Image x:Name="DefaultCoverLocalPreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="DefaultCoverLocalPreviewPlaceholderTextBlock" Text="No preview" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="URL preview" Margin="0,0,0,4" Foreground="Gray" />
                    <Border Width="220" Height="124" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4" Background="#11000000">
                        <Grid>
                            <Image x:Name="DefaultCoverUrlPreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="DefaultCoverUrlPreviewPlaceholderTextBlock" Text="No preview" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="Default background image" FontWeight="SemiBold" />
            <Grid Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Local file" Margin="0,0,0,4" Foreground="Gray" />
                <ComboBox x:Name="DefaultBackgroundImagePathHistoryComboBox"
                          Grid.Row="1"
                          Margin="0,0,12,8"
                          IsEditable="True"
                          IsReadOnly="True"
                          IsTextSearchEnabled="False"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Stretch"
                          DropDownClosed="DefaultBackgroundImagePathHistoryComboBox_DropDownClosed"
                          SelectionChanged="DefaultBackgroundImagePathHistoryComboBox_SelectionChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" ToolTip="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                        Content="×" ToolTip="Remove from history" Tag="{Binding}"
                                        Click="RemoveDefaultBackgroundImagePathHistoryButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Button Padding="12,4" Margin="0,0,8,0" Content="Browse..." Click="BrowseDefaultBackgroundImagePathButton_Click" />
                    <Button Padding="12,4" Content="Clear File" Click="ClearDefaultBackgroundImagePathButton_Click" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Image URL" Margin="0,0,0,4" Foreground="Gray" />
                <TextBox x:Name="DefaultBackgroundImageUrlTextBox" Grid.Row="3" Margin="0,0,12,8" VerticalContentAlignment="Center"
                         TextChanged="DefaultBackgroundImageUrlTextBox_TextChanged" LostFocus="DefaultBackgroundImageUrlTextBox_LostFocus" />
                <Button Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,8" Padding="12,4"
                        Content="Clear URL" Click="ClearDefaultBackgroundImageUrlButton_Click" />
                <StackPanel Grid.Row="4" Margin="0,0,12,0">
                    <TextBlock Text="Local preview" Margin="0,0,0,4" Foreground="Gray" />
                    <Border Width="220" Height="124" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4" Background="#11000000" Margin="0,0,0,8">
                        <Grid>
                            <Image x:Name="DefaultBackgroundLocalPreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="DefaultBackgroundLocalPreviewPlaceholderTextBlock" Text="No preview" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="URL preview" Margin="0,0,0,4" Foreground="Gray" />
                    <Border Width="220" Height="124" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4" Background="#11000000">
                        <Grid>
                            <Image x:Name="DefaultBackgroundUrlPreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="DefaultBackgroundUrlPreviewPlaceholderTextBlock" Text="No preview" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="If both a local file and an image URL are set for the same target, the local file is used first by Apply Default Images."
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8" />
            <TextBlock Text="Apply Default Images replaces the current cover or background image whenever a default image source is configured."
                       TextWrapping="Wrap" Foreground="Gray" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
